{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Download YuNet + SFace models",
      "type": "debugpy",
      "request": "launch",
      "module": "unknown_face_recognition",
      "args": ["download-models"],
      "console": "internalConsole",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. Enroll person (edit name)",
      "type": "debugpy",
      "request": "launch",
      "module": "unknown_face_recognition",
      "args": ["enroll", "--name", "Aarav"],
      "console": "internalConsole",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "3. Build face gallery",
      "type": "debugpy",
      "request": "launch",
      "module": "unknown_face_recognition",
      "args": ["build-gallery"],
      "console": "internalConsole",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "4. Run webcam recognition",
      "type": "debugpy",
      "request": "launch",
      "module": "unknown_face_recognition",
      "args": ["run"],
      "console": "internalConsole",
      "cwd": "${workspaceFolder}"
    }
  ]
}
