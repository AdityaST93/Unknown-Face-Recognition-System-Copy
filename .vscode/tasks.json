{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create project virtual environment",
      "type": "process",
      "command": "python3",
      "args": ["-m", "venv", ".venv"],
      "windows": {
        "command": "py",
        "args": ["-3", "-m", "venv", ".venv"]
      },
      "problemMatcher": []
    },
    {
      "label": "Install project in virtual environment",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pip", "install", "-e", "."],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": ["-m", "pip", "install", "-e", "."]
      },
      "dependsOn": ["Create project virtual environment"],
      "problemMatcher": []
    }
  ]
}
